includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 8
    paths:
        - src
    tmpDir: .phpstan-cache
    reportUnmatchedIgnoredErrors: true

    # The analyzer deliberately models tokenizer/control-flow state with dynamic
    # array shapes. These four identifiers are pinned to the exact files where
    # PHPStan cannot prove the runtime invariant; any new identifier still fails CI.
    ignoreErrors:
        -
            identifier: missingType.iterableValue
            path: src/Analysis/ClassMetadataIndex.php
        -
            identifier: nullsafe.neverNull
            path: src/Analysis/SourceScanner.php
        -
            identifier: identical.alwaysTrue
            path: src/Analysis/SourceScanner.php
        -
            identifier: deadCode.unreachable
            path: src/Analysis/SourceScanner.php
