includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: max
    paths:
        - src
    tmpDir: .phpstan-cache
    reportUnmatchedIgnoredErrors: true

    # Tokenizer/control-flow analysis has a few invariants that PHPStan cannot
    # prove from dynamic PREG/token array shapes. Keep every exception pinned
    # to its exact identifier/file, and require the expected count where an
    # identifier occurs more than once, so unrelated regressions still fail CI.
    ignoreErrors:
        -
            identifier: missingType.iterableValue
            path: src/Analysis/ClassMetadataIndex.php
        -
            identifier: nullsafe.neverNull
            path: src/Analysis/SourceScanner.php
        -
            identifier: identical.alwaysTrue
            path: src/Analysis/SourceScanner.php
        -
            identifier: deadCode.unreachable
            path: src/Analysis/SourceScanner.php
        -
            identifier: cast.string
            path: src/Analysis/SourceScanner.php
            count: 2
